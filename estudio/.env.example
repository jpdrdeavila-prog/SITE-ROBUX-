# Copie este arquivo para .env e preencha. NUNCA envie o .env para o GitHub.
# (Também dá para preencher tudo pela página Configurações do painel.)

# Senha do painel (usuário: joao). Deixe vazio só se rodar no seu próprio computador.
PAINEL_SENHA=

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# ElevenLabs (elevenlabs.io > Profile > API Key) e o ID da voz que você usa
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Instagram (Meta for Developers: conta Business/Creator ligada a uma Página)
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=

# Endereço público deste painel (o Instagram baixa o vídeo daqui). Ex.: https://estudio.seudominio.com
PUBLIC_BASE_URL=

# Telegram (opcional): avisos de aprovação e relatório diário no celular
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
